# Pinterest app credentials — https://developers.pinterest.com/apps/
# Create an app, then copy its ID and secret here. See docs/PINTEREST_SETUP.md.
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# Must match a redirect URI registered on the app *exactly*, including the
# trailing slash. Pinterest requires https:// for every host except localhost.
PINTEREST_REDIRECT_URI=http://localhost:8085/callback

# "sandbox" (trial access — pins and boards are only visible to you)
# or "production" (standard access, after app review).
PINTEREST_ENV=sandbox

# Space-separated OAuth scopes requested during authorization.
PINTEREST_SCOPES=boards:read,boards:write,pins:read,pins:write,user_accounts:read

# Optional: skip the OAuth dance by pasting a token you already hold.
# Leave blank to use the token cache written by `npm run pinterest:authorize`.
PINTEREST_ACCESS_TOKEN=
